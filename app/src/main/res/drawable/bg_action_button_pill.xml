<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Pill background: slightly opaque green to match app style -->
    <solid android:color="#FF58CC02" />

    <!-- Rounded corners to create pill shape -->
    <corners android:radius="28dp" />

    <!-- Optional subtle stroke for better contrast on dark backgrounds -->
    <stroke android:width="1dp" android:color="#88FFFFFF" />

    <!-- Padding so text doesn't stick to edges when used as background -->
    <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
</shape>