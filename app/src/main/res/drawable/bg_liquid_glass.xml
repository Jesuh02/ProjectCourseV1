<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Glass Background: Almost transparent to let BlurView show through -->
    <solid android:color="#1A09090B" />
    
    <!-- Glass Shine Gradient - Enhanced for more "glassy" look -->
    <gradient
        android:startColor="#26FFFFFF"
        android:centerColor="#1AFFFFFF"
        android:endColor="#05FFFFFF"
        android:angle="135"
        android:type="linear" />
        
    <corners android:radius="24dp" />
    
    <!-- Glass Edge Border -->
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
