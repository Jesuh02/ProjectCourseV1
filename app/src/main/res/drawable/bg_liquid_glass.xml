<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Semi-transparent dark base for glass effect (More transparent: ~50% opacity) -->
    <solid android:color="#80000000" />
    
    <!-- Subtle gradient to simulate light reflection -->
    <gradient
        android:startColor="#15FFFFFF"
        android:centerColor="#0AFFFFFF"
        android:endColor="#00FFFFFF"
        android:angle="135"
        android:type="linear" />
        
    <corners android:radius="24dp" />
    
    <!-- Light border for the glass edge -->
    <stroke
        android:width="1dp"
        android:color="#20FFFFFF" />
</shape>
