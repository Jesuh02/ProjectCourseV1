<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: darker translucent fill for a diffused, stronger glass look -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#77000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Gradient overlay to add depth (darker) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#99000000"
                android:centerColor="#66000000"
                android:endColor="#33000000"
                android:angle="135" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Subtle highlight to preserve glass feel -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Thin stroke for separation on dark surfaces -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
