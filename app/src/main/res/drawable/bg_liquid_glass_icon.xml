<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Translucent background for liquid glass effect on icons -->
    <solid android:color="#33FFFFFF" />
    
    <!-- Rounded corners for circular icon background -->
    <corners android:radius="12dp" />
    
    <!-- Subtle stroke for glass edge effect -->
    <stroke android:width="1dp" android:color="#55FFFFFF" />
    
    <!-- Padding to ensure the icon sits nicely in the center -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>