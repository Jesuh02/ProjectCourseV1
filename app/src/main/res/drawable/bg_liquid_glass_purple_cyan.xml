<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Liquid Glass Purple to Cyan Gradient -->
    <gradient
        android:startColor="#009C27B0"
        android:centerColor="#4D9C27B0"
        android:endColor="#E600BCD4"
        android:angle="135"
        android:type="linear" />
        
    <corners android:radius="24dp" />
    
    <!-- Glass Edge Border -->
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
