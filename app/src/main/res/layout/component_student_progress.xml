<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/studentProgressContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#181828"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="16dp"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tu progreso en este curso"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <ProgressBar
        android:id="@+id/courseProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:progressDrawable="@drawable/progress_bar_gradient"
        android:max="100"
        android:progress="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/courseProgressTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#B39DDB"
            android:textSize="14sp"
            tools:text="2 de 3 tareas completadas" />

        <TextView
            android:id="@+id/courseGradeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B39DDB"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Calificación: 7.0/10" />
    </LinearLayout>
    <TextView
        android:id="@+id/courseStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <!-- Certificate section (only visible when student passed) -->
    <FrameLayout
        android:id="@+id/certificateButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Certificate issued date (if certificate was already generated) -->
            <TextView
                android:id="@+id/certificateIssuedDateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:text="✓ Certificado emitido el 14 de noviembre de 2025" />

            <!-- Certificate button -->
            <Button
                android:id="@+id/certificateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generar Certificado"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:drawableLeft="@android:drawable/ic_menu_save"
                android:drawablePadding="8dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>