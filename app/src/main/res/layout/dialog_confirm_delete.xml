<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/confirmCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipToOutline="true"
        card_view:cardCornerRadius="16dp"
        card_view:cardUseCompatPadding="false"
        card_view:cardBackgroundColor="@android:color/transparent"
        android:padding="0dp">

            <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/bg_liquid_glass_dark"
            android:padding="20dp">

            <TextView
                android:id="@+id/confirmDeleteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eliminar curso"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/confirmDeleteMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="end">

                <TextView
                    android:id="@+id/cancelDeleteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:text="Cancelar"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button_outline_light" />

                <TextView
                    android:id="@+id/confirmDeleteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:text="Eliminar"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button_red"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
