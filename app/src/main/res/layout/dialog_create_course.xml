<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/confirmCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        card_view:cardCornerRadius="16dp"
        card_view:cardUseCompatPadding="false"
        card_view:cardBackgroundColor="@android:color/transparent"
        android:padding="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/bg_liquid_glass_dark"
            android:padding="20dp">

            <!-- Icon -->
            <ImageView
                android:id="@+id/courseIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ic_courses"
                android:tint="#3b82f6" />

            <TextView
                android:id="@+id/createCourseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¿Crear un curso?"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/createCourseMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tu video ha sido subido exitosamente. ¿Deseas crear un curso con este video?"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/cancelCreateCourseButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:minHeight="44dp"
                    android:gravity="center"
                    android:text="No, gracias"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button_outline_light" />

                <TextView
                    android:id="@+id/confirmCreateCourseButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:minHeight="44dp"
                    android:gravity="center"
                    android:text="Sí, crear curso"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button_blue"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
