<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatBotRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Top App Bar - Minimalist (Fixed at top, not affected by keyboard) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#000000"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationZ="8dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/arrow_up_float"
            android:rotation="270"
            android:tint="#FFFFFF"
            android:padding="8dp" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/botAvatarImageView"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_dialog_info"
            app:civ_border_width="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/botNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asistente IA"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/clearChatButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/send_button_background"
            android:backgroundTint="#1A1A1A"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#AAAAAA"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Divider below top bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A1A"
        app:layout_constraintTop_toBottomOf="@id/topBar"/>

    <!-- Chat Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/inputAreaWrapper"
        app:stackFromEnd="true" />

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/loadingProgressBar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:indeterminateTint="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/inputAreaWrapper"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Task List Overlay (Bottom Sheet Style - Darker) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/taskListOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#111111"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/inputAreaWrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="350dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="#161616"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/overlayTitleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Seleccionar Curso"
                    android:textColor="#DDDDDD"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="4dp"/>
                <ImageButton
                    android:id="@+id/backToCoursesButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_revert"
                    android:tint="#666666"
                    android:visibility="gone" />
                <ImageButton
                    android:id="@+id/closeTaskListButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#666666" />
            </LinearLayout>

            <!-- Search Bar -->
            <LinearLayout
                android:id="@+id/searchBarContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center_vertical">
                
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#666666"
                    android:layout_marginEnd="8dp" />
                
                <EditText
                    android:id="@+id/overlaySearchEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Buscar por nombre o categoría..."
                    android:textColorHint="#555555"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A1A1A" />

            <TextView
                android:id="@+id/courseNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Curso"
                android:textColor="#666666"
                android:textSize="10sp"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/taskListRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                app:layout_constrainedHeight="true" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Graded Tasks Overlay (Bottom Sheet Style - Darker) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/gradedTasksOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#111111"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/inputAreaWrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="300dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="#161616"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tareas Calificadas"
                    android:textColor="#DDDDDD"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="4dp"/>
                <ImageButton
                    android:id="@+id/closeGradedTasksButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#666666" />
            </LinearLayout>

            <TextView
                android:id="@+id/gradedCourseNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Curso"
                android:textColor="#666666"
                android:textSize="10sp"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gradedTasksRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                app:layout_constrainedHeight="true" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Backgrounds for overlays (Clickable to dismiss) -->
    <View
        android:id="@+id/taskListOverlayBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/gradedTasksOverlayBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Input Area Wrapper -->
    <LinearLayout
        android:id="@+id/inputAreaWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Divider above input -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A1A1A"/>

        <!-- Active Task Indicator (Ultra Minimalist) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:background="#000000"
            android:gravity="center_vertical">
            
            <ImageView
                android:id="@+id/activeContextIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="#444444"
                android:layout_marginEnd="6dp" />
            
            <TextView
                android:id="@+id/activeContextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contexto: "
                android:textColor="#444444"
                android:textSize="10sp" />
            
            <TextView
                android:id="@+id/activeContextValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ninguna tarea"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="normal"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"/>
        </LinearLayout>

        <!-- Message Input -->
        <LinearLayout
            android:id="@+id/messageInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="bottom">

            <ImageButton
                android:id="@+id/gradedTasksButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="#444444"
                android:padding="8dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="2dp"/>

            <EditText
                android:id="@+id/messageEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/message_input_background"
                android:backgroundTint="#111111"
                android:hint="Escribe... (Usa # para tareas)"
                android:textColorHint="#444444"
                android:textColor="#DDDDDD"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:maxLines="5"
                android:textSize="14sp"
                android:inputType="textCapSentences|textMultiLine" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/send_button_background"
                android:backgroundTint="#FFFFFF"
                android:src="@android:drawable/ic_menu_send"
                android:tint="#000000"
                android:padding="8dp"
                android:layout_marginBottom="2dp"/>
        </LinearLayout>

        <!-- Powered by DeepSeek indicator -->
        <TextView
            android:id="@+id/poweredByTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Potenciado por DeepSeek-V3.2-Speciale"
            android:textColor="#444444"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:background="#000000" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
