<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C1A"
    tools:context=".ui.CourseDetailFragment">

    <!-- ═══════════════════════════════════════════════════════════
         FLOATING NAV BAR (transparent, overlaid on hero image)
         ═══════════════════════════════════════════════════════════ -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:contentInsetLeft="0dp"
        android:contentInsetRight="0dp"
        android:contentInsetStartWithNavigation="0dp"
        android:elevation="6dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_nav_button"
                android:contentDescription="@string/back_button_desc"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF" />

            <!-- Hidden IDs: Kotlin compatibility (these are set programmatically) -->
            <ImageView
                android:id="@+id/courseHeroIcon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/courseMetaLabel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/toolbarSubtitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Edit button (creator only) -->
            <ImageButton
                android:id="@+id/editCourseButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_nav_button"
                android:contentDescription="Editar curso"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="#FFFFFF"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- ═══════════════════════════════════════════════════════════
         MAIN SCROLL (starts from top, hero image sits behind navbar)
         ═══════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/courseActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ─────────────────────────────────────────────────
                 HERO IMAGE AREA  (280dp, full width)
                 ───────────────────────────────────────────────── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <!-- Hero thumbnail (loaded by Glide from course.thumbnailUri) -->
                <ImageView
                    android:id="@+id/courseHeroImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:background="#0F1535" />

                <!-- Hero VideoView (hidden initially, auto-plays after 3s if videoUri available) -->
                <VideoView
                    android:id="@+id/heroVideoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Gradient overlay: transparent top → dark bottom -->
                <View
                    android:id="@+id/heroAmbientGlow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.85"
                    android:background="@drawable/bg_hero_gradient_overlay" />

            </FrameLayout>

            <!-- ─────────────────────────────────────────────────
                 CYAN → PURPLE ACCENT LINE  (2dp)
                 ───────────────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/bg_accent_line_gradient" />

            <!-- ─────────────────────────────────────────────────
                 TITLE + DESCRIPTION + TAGS AREA
                 (wrapped for animation compatibility)
                 ───────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/courseTitleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:orientation="vertical"
                android:transitionName="hero_course_header"
                android:translationY="20dp">

                <!-- Hidden layout anchor (animation compat) -->
                <View
                    android:id="@+id/heroHeaderRow"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Featured Badge Row  ☆ Destacado -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star"
                        android:tint="#00D4FF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:text="Destacado"
                        android:textColor="#00D4FF"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Course Title (large, bold, white) -->
                <TextView
                    android:id="@+id/courseTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.024"
                    android:lineSpacingMultiplier="1.15"
                    android:maxLines="2"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="10dp"
                    android:textColor="#E8EAF6"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:translationY="10dp"
                    tools:text="Nested Learning" />

                <!-- Hidden meta divider (animation compat) -->
                <View
                    android:id="@+id/courseMetaDivider"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:alpha="0"
                    android:visibility="gone" />

                <!-- Course Description (gray, multiline) -->
                <TextView
                    android:id="@+id/courseDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.4"
                    android:maxLines="3"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:textColor="#8B8FA8"
                    android:textSize="14sp"
                    android:translationY="16dp"
                    tools:text="Más allá de las arquitecturas profundas tradicionales" />

                <!-- Tags Row: Category pill + Price pill (with configure button for creators) -->
                <LinearLayout
                    android:id="@+id/courseThematicContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="4dp">

                    <!-- Category tag (purple pill) -->
                    <TextView
                        android:id="@+id/courseThematicTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_purple_pill"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:textColor="#9B6BFF"
                        android:textSize="12sp"
                        tools:text="Inteligencia Artificial" />

                    <!-- Price pill container (outlined, always visible, shows price + configure for creators) -->
                    <LinearLayout
                        android:id="@+id/coursePricingContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_tag_outlined_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <!-- Price icon (hidden, Kotlin compatibility) -->
                        <ImageView
                            android:id="@+id/coursePriceIcon"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:contentDescription="@null"
                            android:src="@android:drawable/ic_menu_info_details"
                            android:tint="#10B981"
                            android:visibility="gone" />

                        <!-- Price text (e.g. "Curso Gratuito" or "$49.99 USD") -->
                        <TextView
                            android:id="@+id/coursePriceTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:includeFontPadding="false"
                            android:textColor="#8B8FA8"
                            android:textSize="12sp"
                            tools:text="Curso Gratuito" />

                        <!-- Configure button (creator only, shown by Kotlin) -->
                        <Button
                            android:id="@+id/togglePriceButton"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tag_purple_pill"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:includeFontPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="Configurar"
                            android:textAllCaps="false"
                            android:textColor="#9B6BFF"
                            android:textSize="11sp"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Hidden accent divider (animation compat) -->
                <View
                    android:id="@+id/courseAccentDivider"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:alpha="0"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ─────────────────────────────────────────────────
                 PROGRESS CARD  (dark card with cyan accent)
                 ───────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/courseProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:alpha="0"
                android:background="@drawable/bg_dark_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:translationY="28dp"
                android:visibility="gone">

                <!-- Header row: title (left) + percentage (right, cyan) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/progressTitleTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:text="Tu Progreso en el Curso"
                        android:textColor="#E8EAF6"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressLoadingIndicator"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="10dp"
                        android:indeterminate="true"
                        android:indeterminateTint="#00D4FF"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/progressPercentTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:text="--"
                        android:textColor="#00D4FF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Progress bar (gradient cyan → purple) -->
                <ProgressBar
                    android:id="@+id/courseProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="14dp"
                    android:indeterminateOnly="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_bar_drawable" />

                <!-- Stats row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/progressStatusTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="Actualizando progreso..."
                        android:textAllCaps="false"
                        android:textColor="#8B8FA8"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Certificate button (shown on completion) -->
                <FrameLayout
                    android:id="@+id/certificateButtonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:alpha="0"
                    android:translationY="16dp"
                    android:visibility="gone">

             

                </FrameLayout>

            </LinearLayout>

            <!-- ─────────────────────────────────────────────────
                 PAYMENT UPSELL CARD (non-creators, paid courses)
                 ───────────────────────────────────────────────── -->
            <FrameLayout
                android:id="@+id/paymentButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:alpha="0"
                android:background="@drawable/bg_dark_card"
                android:elevation="6dp"
                android:padding="20dp"
                android:translationY="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/paymentTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="Curso de Pago"
                        android:textColor="#E8EAF6"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/paymentDescriptionTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:lineSpacingMultiplier="1.4"
                        android:text="Para acceder al contenido completo de este curso, es necesario realizar un pago."
                        android:textColor="#8B8FA8"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/paymentButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_action_button_cupertino"
                        android:drawablePadding="10dp"
                        android:drawableStart="@drawable/ic_plus_round"
                        android:drawableTint="#FFFFFFFF"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Pagar Ahora"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/paymentPSEButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_action_button_pill_outline"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Pagar con PSE"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

            <!-- Enrollment banner for students without approved access -->
            <LinearLayout
                android:id="@+id/enrollmentBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="32dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/enrollmentBannerIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="#BF5AF2"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/enrollmentBannerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acceso Restringido"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/enrollmentBannerMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Necesitas solicitar acceso a este curso"
                    android:textColor="#8E8E93"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="24dp"/>

                <Button
                    android:id="@+id/requestEnrollmentButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Solicitar Acceso"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#BF5AF2"
                    android:textAllCaps="false"
                    android:visibility="visible"/>
            </LinearLayout>

            <!-- ─────────────────────────────────────────────────
                 TAB BAR  (Tema | Tareas) — pill style
                 ───────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/courseTabStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:alpha="0"
                android:background="@drawable/bg_tab_container_dark"
                android:elevation="4dp"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:translationY="20dp">

                <!-- Tema tab — bg_tab_pill_selector responds to isSelected set in Kotlin -->
                <LinearLayout
                    android:id="@+id/tabDocumentos"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_pill_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tabDocumentosLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:text="Temas"
                        android:textAllCaps="false"
                        android:textColor="#E8EAF6"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabDocumentosCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_tab_count_cyan"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:minWidth="20dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#080C1A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Tareas tab — same selector, inactive by default -->
                <LinearLayout
                    android:id="@+id/tabTareas"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_pill_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tabTareasLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:text="Tareas"
                        android:textAllCaps="false"
                        android:textColor="#8B8FA8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabTareasCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_tab_count_purple"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:minWidth="20dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <!-- ─────────────────────────────────────────────────
                 SECTION HEADING ROW
                 ───────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/sectionHeadingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="10dp"
                android:alpha="0"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:translationY="18dp">

                <TextView
                    android:id="@+id/sectionHeadingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:includeFontPadding="false"
                    android:text="Contenido del Tema"
                    android:textColor="#E8EAF6"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sectionHeadingSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:textColor="#8B8FA8"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ─────────────────────────────────────────────────
                 TOPICS CONTAINER (dynamically populated)
                 ───────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/topicsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:translationY="24dp" />

            <!-- ─────────────────────────────────────────────────
                 EMPTY STATES
                 ───────────────────────────────────────────────── -->
            <TextView
                android:id="@+id/noTopicsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:alpha="0"
                android:background="@drawable/bg_dark_card"
                android:elevation="4dp"
                android:fontFamily="@font/sf_pro_display_regular"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:text="Este curso aún no tiene temas."
                android:textColor="#8B8FA8"
                android:translationY="18dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/noTasksTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="40dp"
                android:alpha="0"
                android:background="@drawable/bg_dark_card"
                android:elevation="4dp"
                android:fontFamily="@font/sf_pro_display_regular"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:text="No hay tareas en este curso."
                android:textColor="#8B8FA8"
                android:translationY="18dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════════════════════
         SKELETON LOADING OVERLAY
         ═══════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/skeletonLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#080C1A"
        android:stateListAnimator="@animator/skeleton_shimmer"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/layout_course_detail_skeleton" />

    </FrameLayout>

    <!-- ═══════════════════════════════════════════════════════════
         COURSE ACTION BAR (creator buttons: + Tema / + Tarea)
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/courseActionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:background="@drawable/bg_surface_glass"
        android:elevation="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:translationY="28dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- + Tema button (gradient pill) -->
        <LinearLayout
            android:id="@+id/addTopicButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_creator_action_button"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:stateListAnimator="@null">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_plus_round"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="Nuevo Tema"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- + Tarea button (gradient pill, slightly different shade) -->
        <LinearLayout
            android:id="@+id/addTaskButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_entregar_button"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:stateListAnimator="@null">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_plus_round"
                android:tint="#00D4FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="Nueva Tarea"
                android:textAllCaps="false"
                android:textColor="#00D4FF"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         BOTTOM NAVIGATION
         ═══════════════════════════════════════════════════════════ -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/component_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════
         STUDENT PROGRESS FRAGMENT CONTAINER
         ═══════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/studentProgressFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

</androidx.constraintlayout.widget.ConstraintLayout>
