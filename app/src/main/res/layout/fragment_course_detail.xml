<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context=".ui.CourseDetailFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="407dp"
        android:layout_height="77dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:animateLayoutChanges="true"
        android:background="@drawable/bg_toolbar_gradient"
        android:clipToPadding="false"
        android:contentInsetLeft="0dp"
        android:contentInsetRight="0dp"
        android:contentInsetStartWithNavigation="0dp"
        android:elevation="0dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_nav_button"
                android:contentDescription="@string/back_button_desc"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back"
                android:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/toolbarSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.12"
                    android:text="Panel maestro"
                    android:textColor="#C7D5FF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="Control del curso"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:translationY="2dp" />
            </LinearLayout>

            <View
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:alpha="0.0"
                android:background="@drawable/bg_nav_button"
                android:visibility="invisible" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/courseActionBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

             <!-- Course Title & Hero Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/courseTitleContainer"
                android:layout_width="wrap_content"
                android:layout_height="290dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="20dp"
                android:alpha="0"
                android:animateLayoutChanges="true"
                android:background="@drawable/bg_course_title_pill"
                android:clipToPadding="false"
                android:elevation="12dp"
                android:minHeight="280dp"
                android:paddingStart="26dp"
                android:paddingTop="24dp"
                android:paddingEnd="26dp"
                android:paddingBottom="24dp"
                android:stateListAnimator="@animator/glass_card_state_list"
                android:transitionName="hero_course_header"
                android:translationY="-20dp">

                <View
                    android:id="@+id/heroAmbientGlow"
                    android:layout_width="310dp"
                    android:layout_height="248dp"
                    android:alpha="0.30"
                    android:background="@drawable/bg_course_header_glow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/heroLightSweep"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="-72dp"
                    android:layout_marginEnd="-52dp"
                    android:alpha="0.55"
                    android:animation="@anim/hero_light_sweep_motion"
                    android:background="@drawable/bg_hero_light_sweep"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Header Row with Icon, Meta Label and Edit Button -->
                <LinearLayout
                    android:id="@+id/heroHeaderRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/courseHeroIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:alpha="0.86"
                        android:background="@drawable/bg_stat_icon_circle"
                        android:contentDescription="Sello del curso"
                        android:padding="8dp"
                        android:src="@drawable/ic_sparkle"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/courseMetaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:alpha="0"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.18"
                        android:text="Instantánea"
                        android:textAllCaps="false"
                        android:textColor="#D7E2FF"
                        android:textSize="12sp"
                        android:translationY="-6dp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/editCourseButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:alpha="0.9"
                        android:background="@drawable/bg_nav_button"
                        android:contentDescription="Editar curso"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_edit"
                        android:tint="#F0E7FF"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:id="@+id/courseMetaDivider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:alpha="0.4"
                    android:background="@drawable/course_title_accent"
                    app:layout_constraintEnd_toEndOf="@id/heroHeaderRow"
                    app:layout_constraintStart_toStartOf="@id/heroHeaderRow"
                    app:layout_constraintTop_toBottomOf="@id/heroHeaderRow" />

                <!-- Course Title -->
                <TextView
                    android:id="@+id/courseTitleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.024"
                    android:lineSpacingMultiplier="1.18"
                    android:maxLines="2"
                    android:shadowColor="#66151930"
                    android:shadowDx="0"
                    android:shadowDy="6"
                    android:shadowRadius="12"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:translationY="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/courseMetaDivider"
                    tools:text="¿Quién nació primero?" />

                <!-- Course Description -->
                <TextView
                    android:id="@+id/courseDescriptionTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.01"
                    android:lineSpacingMultiplier="1.35"
                    android:maxLines="3"
                    android:textColor="#E8DDFF"
                    android:textSize="14sp"
                    android:translationY="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/courseTitleTextView"
                    tools:text="Explora contenido premium curado para tus estudiantes." />

                <!-- Temática / Category Badge -->
                <LinearLayout
                    android:id="@+id/courseThematicContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/courseDescriptionTextView">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:alpha="0.8"
                        android:contentDescription="Categoría"
                        android:src="@drawable/ic_sparkle"
                        android:tint="#9B7EFF" />

                    <TextView
                        android:id="@+id/courseThematicTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.05"
                        android:text="Temática: Educación"
                        android:textColor="#C9B8FF"
                        android:textSize="13sp"
                        tools:text="Temática: Programación" />
                </LinearLayout>

                <!-- Pricing Section -->
                <LinearLayout
                    android:id="@+id/coursePricingContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_surface_glass"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/courseThematicContainer">

                    <!-- Price Type Icon -->
                    <ImageView
                        android:id="@+id/coursePriceIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Tipo de curso"
                        android:src="@android:drawable/ic_menu_info_details"
                        android:tint="#4CAF50"
                        tools:tint="#FFB300" />

                    <!-- Price Text -->
                    <TextView
                        android:id="@+id/coursePriceTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:text="Curso Gratuito"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        tools:text="$49.99 USD" />

                    <!-- Toggle Price Button (for creators) -->
                    <Button
                        android:id="@+id/togglePriceButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/button_premium"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Configurar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Accent Divider -->
                <View
                    android:id="@+id/courseAccentDivider"
                    android:layout_width="88dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="16dp"
                    android:alpha="0"
                    android:background="@drawable/course_title_accent"
                    android:scaleX="0.64"
                    android:translationY="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/coursePricingContainer" />
            </androidx.constraintlayout.widget.ConstraintLayout>



            <!-- Add this after the creator info container and before the tabs -->
            <LinearLayout
                android:id="@+id/courseProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:background="@drawable/bg_surface_glass"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:elevation="6dp"
                android:visibility="gone"
                android:alpha="0"
                android:translationY="28dp">

                <TextView
                    android:id="@+id/progressTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tu Progreso en el Curso"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.01"
                    android:fontFamily="@font/sf_pro_display_semibold" />

                <ProgressBar
                    android:id="@+id/courseProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:progressDrawable="@drawable/progress_bar_drawable"
                    android:max="100"
                    android:progress="0"
                    android:indeterminateOnly="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/progressPercentTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0% completado"
                        android:textColor="#D7CCFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:textAllCaps="false" />

                    <TextView
                        android:id="@+id/progressStatusTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calificación: 0/10"
                        android:textColor="#D7CCFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- Certificate Button Container with Animation -->
                <FrameLayout
                    android:id="@+id/certificateButtonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:visibility="gone"
                    android:alpha="0"
                    android:translationY="16dp">

                    <Button
                        android:id="@+id/certificateButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Descargar Certificado"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_certificate"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/certificate_button_background"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:textAllCaps="false"
                        android:gravity="center" />
                </FrameLayout>
            </LinearLayout>

            <!-- Payment upsell card for non-creators -->
            <FrameLayout
                android:id="@+id/paymentButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_surface_glass"
                android:padding="22dp"
                android:visibility="gone"
                android:elevation="6dp"
                android:alpha="0"
                android:translationY="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/paymentTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Curso de Pago"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/paymentDescriptionTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Para acceder al contenido completo de este curso, es necesario realizar un pago."
                        android:textColor="#D7CCFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/paymentButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Pagar Ahora"
                        android:background="@drawable/bg_action_button_cupertino"
                        android:drawableStart="@drawable/ic_plus_round"
                        android:drawablePadding="10dp"
                        android:drawableTint="#FFFFFFFF"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/paymentPSEButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Pagar con PSE"
                        android:background="@drawable/bg_action_button_pill_outline"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tabs for Contenido / Tareas -->
            <LinearLayout
                android:id="@+id/courseTabStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_tab_container_glass"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="18dp"
                android:elevation="4dp"
                android:alpha="0"
                android:translationY="20dp">

                <TextView
                    android:id="@+id/tabDocumentos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Contenido"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/premium_tab_text_selector"
                    android:background="@drawable/tab_selector_left"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/tabTareas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tareas"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/premium_tab_text_selector"
                    android:background="@drawable/tab_selector_right"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- Section Title -->
            <LinearLayout
                android:id="@+id/sectionHeadingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:alpha="0"
                android:translationY="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Contenido del curso"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/sf_pro_display_semibold" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#6E4CFF"
                    android:alpha="0.7" />
            </LinearLayout>

            <!-- KEEP ONLY THIS SET -->
            <LinearLayout
                android:id="@+id/topicsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:animateLayoutChanges="true"
                android:layoutAnimation="@anim/layout_fall_down"
                android:alpha="0"
                android:translationY="24dp">
                <!-- Dynamically added: item_course_topic_detail.xml, item_course_task_detail.xml, etc. -->
            </LinearLayout>

            <TextView
                android:id="@+id/noTopicsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Este curso aún no tiene temas."
                android:textColor="#C2B8FF"
                android:gravity="center"
                android:visibility="gone"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_surface_glass"
                android:elevation="4dp"
                android:alpha="0"
                android:translationY="18dp"
                android:fontFamily="@font/sf_pro_display_regular"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/noTasksTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No hay tareas en este curso."
                android:textColor="#C2B8FF"
                android:gravity="center"
                android:visibility="gone"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="40dp"
                android:background="@drawable/bg_surface_glass"
                android:elevation="4dp"
                android:alpha="0"
                android:translationY="18dp"
                android:fontFamily="@font/sf_pro_display_regular"
                tools:visibility="visible"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>    <!-- Course Action Buttons (above bottom navigation) -->
    <LinearLayout
        android:id="@+id/courseActionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_surface_glass"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:elevation="10dp"
        android:alpha="0"
        android:translationY="28dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/addTopicButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_button_cupertino"
            android:drawableStart="@drawable/ic_plus_round"
            android:drawablePadding="10dp"
            android:drawableTint="#FFFFFFFF"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="+ Tema"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginEnd="6dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/addTaskButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_button_cupertino"
            android:drawableStart="@drawable/ic_plus_round"
            android:drawablePadding="10dp"
            android:drawableTint="#FFFFFFFF"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="+ Tarea"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginStart="6dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- Bottom Navigation using the component -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/component_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Move this FrameLayout INSIDE the ConstraintLayout, not after it -->
    <FrameLayout
        android:id="@+id/studentProgressFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>