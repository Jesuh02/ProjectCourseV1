<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:clipToPadding="false"
    android:clipChildren="false"
    tools:context=".ui.DatabaseQueryFragment">

    <!-- Modern Header - Professional and Clean -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical"
        android:background="#0D0D0D"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Status Indicator -->
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#10A37F"
            android:layout_marginEnd="12dp" />

        <!-- Title and Model Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/messageCounterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Database Assistant"
                android:textColor="#E8E8E8"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.005" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DeepSeek-V3.2-Speciale"
                android:textColor="#666666"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Action buttons -->
        <ImageButton
            android:id="@+id/deleteConversationButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Nueva conversación"
            android:padding="8dp"
            android:src="@drawable/ic_add"
            app:tint="#999999" />

        <ImageButton
            android:id="@+id/exportConversationButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Más opciones"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            app:tint="#999999" />
    </LinearLayout>

    <!-- Subtle divider -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A1A"
        app:layout_constraintTop_toBottomOf="@id/headerLayout" />

    <!-- Chat Area with improved spacing -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toTopOf="@id/inputContainer" />

    <!-- Modern Empty State -->
    <LinearLayout
        android:id="@+id/emptyStateContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0.6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Elegant brain icon -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#1A1A1A">

            <ImageView
                android:id="@+id/centerBrainIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_brain"
                app:tint="#4A4A4A" />
        </FrameLayout>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ask anything about your data"
            android:textColor="#666666"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Natural language queries powered by AI"
            android:textColor="#4A4A4A"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Chart Container (hidden by default) -->
    <FrameLayout
        android:id="@+id/chartContainer"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        android:background="@drawable/bg_message_user"
        android:backgroundTint="#111111"
        android:elevation="2dp"
        app:layout_constraintBottom_toTopOf="@id/inputContainer"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintVertical_bias="0.0" />

    <!-- Chart Controls (hidden by default) -->
    <LinearLayout
        android:id="@+id/chartControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/chartContainer"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp">
        
        <Button
            android:id="@+id/zoomInButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="+"
            android:textSize="18sp"
            android:backgroundTint="#1A1A1A"
            android:textColor="#FFFFFF"
            style="@style/Widget.Material3.Button.UnelevatedButton" />
            
        <Button
            android:id="@+id/zoomOutButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="−"
            android:textSize="18sp"
            android:backgroundTint="#1A1A1A"
            android:textColor="#FFFFFF"
            style="@style/Widget.Material3.Button.UnelevatedButton" />
            
        <Button
            android:id="@+id/resetChartButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="↻"
            android:textSize="18sp"
            android:backgroundTint="#1A1A1A"
            android:textColor="#FFFFFF"
            style="@style/Widget.Material3.Button.UnelevatedButton" />
    </LinearLayout>

    <!-- Modern Scroll to Bottom FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScrollToBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_keyboard_arrow_down"
        app:tint="#E0E0E0"
        app:backgroundTint="#1A1A1A"
        app:borderWidth="0dp"
        app:fabSize="mini"
        app:elevation="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/inputContainer"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Modern Input Area -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0A0A0A"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Input row with modern design -->
        <LinearLayout
            android:id="@+id/queryInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:background="@drawable/bg_input_container_cursor"
            android:padding="6dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Attach file button -->
            <FrameLayout
                android:id="@+id/attachFileButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_attach_file"
                    app:tint="#888888" />
            </FrameLayout>

            <!-- Input field -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Attached files preview container -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/attachedFilesRecyclerView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginBottom="4dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:orientation="horizontal" />

                <EditText
                    android:id="@+id/queryInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Message Database..."
                    android:textColor="#E0E0E0"
                    android:textColorHint="#555555"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="4dp"
                    android:background="@android:color/transparent"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6"
                    android:minLines="1"
                    android:scrollbars="vertical"
                    android:gravity="top"
                    android:imeOptions="actionSend" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="#AAAAAA"
                android:padding="8dp"/>

            <!-- Send button -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/excelButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Excel"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2E7D32"
                        android:paddingHorizontal="8dp"
                        android:visibility="gone"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.Material3.Button.UnelevatedButton" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/sendButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_send"
                        app:tint="#FFFFFF"
                        app:backgroundTint="#10A37F"
                        app:borderWidth="0dp"
                        app:fabSize="mini"
                        app:elevation="0dp"
                        app:pressedTranslationZ="2dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/loadingSpinner"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="#10A37F" />
            </FrameLayout>
        </LinearLayout>

        <!-- Voice Input Mode (Replaces Message Input when active) -->
        <LinearLayout
            android:id="@+id/voiceInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="#0A0A0A"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/cancelVoiceButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@drawable/circle_background_dark"
                android:backgroundTint="#333333"
                android:padding="8dp"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/voiceStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver texto"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>

                <com.example.tareamov.ui.widget.VoiceVisualizerView
                    android:id="@+id/voiceVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/stopRecordingButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/send_button_background"
                android:backgroundTint="#FFFFFF"
                android:src="@android:drawable/ic_media_pause"
                android:tint="#000000"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Modern footer with model info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#10A37F"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/poweredByTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DeepSeek-V3.2-Speciale"
                android:textColor="#4A4A4A"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • Advanced AI"
                android:textColor="#3A3A3A"
                android:textSize="10sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden Views for Compatibility -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView android:id="@+id/resultText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </ScrollView>
    
    <LinearLayout
        android:id="@+id/chatHistoryHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageButton android:id="@+id/clearHistoryButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <ImageButton android:id="@+id/historyButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/messageCountText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/messageInfoBar" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    
    <TextView android:id="@+id/currentUserText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    
    <!-- Hidden quick actions layout -->
    <LinearLayout
        android:id="@+id/quickActionsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.chip.Chip android:id="@+id/chipClearChat" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <com.google.android.material.chip.Chip android:id="@+id/chipHelp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <com.google.android.material.chip.Chip android:id="@+id/chipExamples" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
