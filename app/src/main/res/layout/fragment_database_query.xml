<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.DatabaseQueryFragment">

    <!-- Header with title and connection status -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/brainIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_brain"
                android:tint="#10A37F" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Sistema MCP"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/connectionIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#4CAF50" />

            <TextView
                android:id="@+id/connectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Conectado"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtitle with user indicator -->
    <LinearLayout
        android:id="@+id/subtitleLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Consulta de Base de Datos"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/userIndicatorLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_user_indicator"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_person"
                android:tint="#10A37F"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/currentUserText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>    <!-- Chat history header -->
    <LinearLayout
        android:id="@+id/chatHistoryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#000000"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/subtitleLayout">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_history"
            android:tint="#10A37F" />

        <TextView
            android:id="@+id/historyHeaderText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Conversaciones anteriores"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/clearHistoryButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#80FFFFFF"
            android:contentDescription="Limpiar historial" />
    </LinearLayout>

    <!-- Enhanced Chat RecyclerView with ChatGPT-style full-width layout -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="true"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/chatHistoryHeader"
        app:layout_constraintBottom_toTopOf="@id/typingIndicator" />

    <!-- Enhanced typing indicator with LLM branding -->
    <LinearLayout
        android:id="@+id/typingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_typing_indicator"
        android:gravity="start|center_vertical"
        android:visibility="gone"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/queryInputLayout">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_brain"
            android:tint="#10A37F"
            android:padding="4dp"
            android:background="@drawable/circle_bg_purple" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Llama 3.3 70B"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="está pensando..."
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            style="?android:attr/progressBarStyleSmall"
            android:indeterminateTint="#10A37F" />
    </LinearLayout>

    <!-- Brain Icon in the center - shown when chat is empty -->
    <ImageView
        android:id="@+id/centerBrainIcon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_brain"
        android:tint="#10A37F"
        android:alpha="0.8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/queryInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Keep the ScrollView for compatibility but make it invisible by default -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/subtitleLayout"
        app:layout_constraintBottom_toTopOf="@id/queryInputLayout">

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:textIsSelectable="true"
            android:text="Sistema MCP - Consulta Inteligente\n\nUtiliza lenguaje natural para consultar la base de datos. El sistema procesará tu consulta y mostrará los resultados relevantes." />
    </ScrollView>

    <!-- Chart container (hidden by default) -->
    <FrameLayout
        android:id="@+id/chartContainer"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/subtitleLayout"
        app:layout_constraintBottom_toTopOf="@id/chartControls" />

    <!-- Chart controls (hidden by default) -->
    <LinearLayout
        android:id="@+id/chartControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/queryInputLayout">

        <Button
            android:id="@+id/zoomInButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zoom +"
            android:backgroundTint="#10A37F"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/zoomOutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zoom -"
            android:backgroundTint="#10A37F"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/resetChartButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reiniciar"
            android:backgroundTint="#10A37F" />
    </LinearLayout>    <!-- Floating action button for chat history -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChatHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_history"
        app:tint="#FFFFFF"
        app:backgroundTint="#888888"
        app:elevation="6dp"
        app:borderWidth="0dp"
        android:contentDescription="Ver historial de chat"
        app:fabSize="mini"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/queryInputLayout" />

    <!-- Scroll to bottom button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScrollToBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:src="@drawable/ic_keyboard_arrow_down"
        app:tint="#FFFFFF"
        app:backgroundTint="#10A37F"
        app:elevation="6dp"
        app:borderWidth="0dp"
        android:contentDescription="Ir al final del chat"
        app:fabSize="mini"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/queryInputLayout" />

    <!-- Enhanced input area with better design -->
    <LinearLayout
        android:id="@+id/queryInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_input_area_enhanced"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Message counter and info bar -->
        <LinearLayout
            android:id="@+id/messageInfoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/messageCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 mensajes en esta conversación"
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/exportChatButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#80FFFFFF"
                android:contentDescription="Exportar chat"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Attachment button (for future features) -->
            <ImageButton
                android:id="@+id/attachButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_attach"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#80FFFFFF"
                android:contentDescription="Adjuntar archivo"
                android:visibility="gone" />

            <!-- Enhanced input field with chat-like design -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="#10A37F"
                app:boxStrokeWidth="2dp"
                app:hintTextColor="#888888"
                app:boxBackgroundColor="#000000"
                app:boxCornerRadiusTopStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusBottomEnd="24dp"
                app:hintAnimationEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/queryInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pregunta algo a Llama 3.3..."
                    android:textColorHint="#B0B0B0"
                    android:textColor="#FFFFFF"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="1"
                    android:maxLines="6"
                    android:textSize="16sp"
                    android:padding="16dp"
                    android:background="@android:color/transparent"
                    android:lineSpacingExtra="2dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Enhanced send button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/sendButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_send"
                app:tint="#FFFFFF"
                app:backgroundTint="#10A37F"
                app:elevation="4dp"
                app:borderWidth="0dp"
                android:contentDescription="Enviar consulta"
                app:fabSize="mini" />
        </LinearLayout>

        <!-- Quick actions row -->
        <LinearLayout
            android:id="@+id/quickActionsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center"
            android:visibility="gone">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipClearChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Limpiar chat"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#888888"
                app:chipStrokeColor="#10A37F"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Ayuda"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#4A5F7A"
                app:chipStrokeColor="#9370DB"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipExamples"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ejemplos"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#4A5F7A"
                app:chipStrokeColor="#9370DB"
                app:chipStrokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>


    <!-- Enhanced model info with better styling -->
    <LinearLayout
        android:id="@+id/modelInfoLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_model_info"
        app:layout_constraintBottom_toTopOf="@id/queryInputLayout">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_cpu"
            android:tint="#10A37F"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/modelInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Potenciado por Llama 3.3 70B • Conversacional • RAG Habilitado"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="italic"
            android:gravity="center" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#4CAF50" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>