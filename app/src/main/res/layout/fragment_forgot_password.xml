<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Back button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:padding="8dp"
                app:tint="#8B5CF6"
                android:contentDescription="Volver" />
        </LinearLayout>

        <!-- Icon -->
        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardBackgroundColor="#1A0E2E"
            app:cardElevation="0dp"
            android:layout_marginBottom="20dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:src="@drawable/ic_lock"
                app:tint="#8B5CF6"
                android:contentDescription="Lock icon" />
        </androidx.cardview.widget.CardView>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recuperar contraseña"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresa tu correo electrónico y te enviaremos un código de 4 dígitos para restablecer tu contraseña."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="28dp" />

        <!-- ═══════════════════════════════════════════════ -->
        <!-- STEP 1: Email                                   -->
        <!-- ═══════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/step1Layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#16213E">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_email"
                        app:tint="#8B5CF6"
                        android:contentDescription="Email" />
                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="correo@ejemplo.com"
                        android:textColorHint="#7C7C7C"
                        android:textColor="#FFFFFF"
                        android:inputType="textEmailAddress"
                        android:textSize="15sp"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:imeOptions="actionDone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnSendCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_gradient_purple"
                android:text="Enviar código"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="14dp"
                android:elevation="4dp" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- STEP 2: Code verification                       -->
        <!-- ═══════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/step2Layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 4 digit boxes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/etCode1"
                    android:layout_width="64dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/code_box_bg"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textAlignment="center" />

                <EditText
                    android:id="@+id/etCode2"
                    android:layout_width="64dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/code_box_bg"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textAlignment="center" />

                <EditText
                    android:id="@+id/etCode3"
                    android:layout_width="64dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/code_box_bg"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textAlignment="center" />

                <EditText
                    android:id="@+id/etCode4"
                    android:layout_width="64dp"
                    android:layout_height="72dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/code_box_bg"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textAlignment="center" />
            </LinearLayout>

            <Button
                android:id="@+id/btnVerifyCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_gradient_purple"
                android:text="Verificar código"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="14dp"
                android:elevation="4dp" />

            <TextView
                android:id="@+id/tvResendCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="Reenviar código"
                android:textColor="#8B5CF6"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- STEP 3: New password                            -->
        <!-- ═══════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/step3Layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- New password field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nueva contraseña"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#16213E">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lock"
                        app:tint="#8B5CF6"
                        android:contentDescription="Password" />
                    <EditText
                        android:id="@+id/etNewPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Mínimo 6 caracteres"
                        android:textColorHint="#7C7C7C"
                        android:textColor="#FFFFFF"
                        android:inputType="textPassword"
                        android:textSize="15sp"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />
                    <ImageView
                        android:id="@+id/toggleNewPassword"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_visibility"
                        app:tint="#7C7C7C"
                        android:contentDescription="Mostrar/ocultar" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Password strength hints -->
            <LinearLayout
                android:id="@+id/passwordHintContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <View android:id="@+id/dotLength" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/hint_dot" android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/tvHintLength" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Al menos 6 caracteres" android:textColor="#94A3B8" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <View android:id="@+id/dotNumber" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/hint_dot" android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/tvHintNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 número" android:textColor="#94A3B8" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <View android:id="@+id/dotUpper" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/hint_dot" android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/tvHintUpper" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 letra mayúscula" android:textColor="#94A3B8" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <View android:id="@+id/dotLower" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/hint_dot" android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/tvHintLower" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 letra minúscula" android:textColor="#94A3B8" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <View android:id="@+id/dotSymbol" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/hint_dot" android:layout_marginEnd="8dp" />
                    <TextView android:id="@+id/tvHintSymbol" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 símbolo (ej. !@#$%)" android:textColor="#94A3B8" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Confirm password field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmar contraseña"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#16213E">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lock"
                        app:tint="#8B5CF6"
                        android:contentDescription="Confirm password" />
                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Repite la contraseña"
                        android:textColorHint="#7C7C7C"
                        android:textColor="#FFFFFF"
                        android:inputType="textPassword"
                        android:textSize="15sp"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />
                    <ImageView
                        android:id="@+id/toggleConfirmPassword"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_visibility"
                        app:tint="#7C7C7C"
                        android:contentDescription="Mostrar/ocultar" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_gradient_purple"
                android:text="Cambiar contraseña"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="14dp"
                android:elevation="4dp" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- STEP 4: Success                                 -->
        <!-- ═══════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/step4Layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="36dp"
                app:cardBackgroundColor="#112211"
                app:cardElevation="0dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="✓"
                    android:textColor="#22c55e"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Contraseña actualizada!"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu contraseña ha sido restablecida correctamente. Ya puedes iniciar sesión."
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnGoToLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_gradient_purple"
                android:text="Ir al inicio de sesión"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="14dp"
                android:elevation="4dp" />
        </LinearLayout>

        <!-- Error message (shared) -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Progress bar (shared) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:layout_gravity="center"
            android:indeterminateTint="#8B5CF6"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
