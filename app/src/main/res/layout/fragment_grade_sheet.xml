<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C1A"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="📊 Planilla de Calificaciones"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/rounded_corner_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#8E8E93"
            android:contentDescription="Buscar" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:hint="Buscar estudiante..."
            android:textColorHint="#8E8E93"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Loading spinner -->
    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="60dp"
        android:visibility="gone"
        android:indeterminateTint="#BF5AF2" />

    <!-- Empty message -->
    <TextView
        android:id="@+id/emptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="40dp"
        android:text="No se encontraron estudiantes"
        android:textColor="#8E8E93"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Grade sheet table (horizontal + vertical scroll) -->
    <HorizontalScrollView
        android:id="@+id/horizontalScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header row -->
                <LinearLayout
                    android:id="@+id/headerRow"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="#1A1E35"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <!-- Data rows container -->
                <LinearLayout
                    android:id="@+id/dataRowsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>
    </HorizontalScrollView>

    <!-- Bulk action bar -->
    <LinearLayout
        android:id="@+id/bulkBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111528"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <Spinner
            android:id="@+id/bulkTypeSpinner"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_corner_background"
            android:popupBackground="#1C1C1E" />

        <EditText
            android:id="@+id/bulkGradeInput"
            android:layout_width="60dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_corner_background"
            android:gravity="center"
            android:hint="Nota"
            android:textColorHint="#8E8E93"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnApplyBulk"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_button_background"
            android:text="Aplicar"
            android:textColor="#BF5AF2"
            android:textSize="13sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Save footer -->
    <LinearLayout
        android:id="@+id/saveFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111528"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/dirtyCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FF9500"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/rounded_button_background"
            android:text="Guardar Notas"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:paddingHorizontal="24dp" />
    </LinearLayout>

</LinearLayout>
