<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:fillViewport="true"
    tools:context=".ui.LoginFragment">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="24dp">

    <!-- Partículas de fondo animadas -->
    <View
        android:id="@+id/particle1"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/circle_purple_glow"
        android:alpha="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="50dp"
        android:layout_marginTop="100dp" />

    <View
        android:id="@+id/particle2"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:background="@drawable/circle_purple_glow"
        android:alpha="0.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="80dp"
        android:layout_marginTop="180dp" />

    <View
        android:id="@+id/particle3"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/circle_purple_glow"
        android:alpha="0.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="120dp"
        android:layout_marginBottom="200dp" />

    <!-- Fondo superior con gradiente morado -->
    <View
        android:id="@+id/topBackground"
        android:layout_width="412dp"
        android:layout_height="230dp"
        android:background="@drawable/gradient_header_login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título CourseV con estilo cursivo -->
    <TextView
        android:id="@+id/courseTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CourseV"
        android:textSize="32sp"
        android:textColor="#FFFFFF"
        android:textStyle="italic"
        android:fontFamily="serif"
        android:letterSpacing="0.1"
        android:shadowColor="#8B5CF6"
        android:shadowRadius="10"
        android:shadowDx="0"
        android:shadowDy="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topBackground"
        app:layout_constraintBottom_toTopOf="@+id/profileIconContainer"
        android:layout_marginTop="24dp" />

    <!-- Icono de código como símbolo de programación -->
    <ImageView
        android:id="@+id/codeIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_code"
        app:tint="#FFFFFF"
        android:alpha="0.8"
        app:layout_constraintStart_toEndOf="@+id/courseTitleText"
        app:layout_constraintTop_toTopOf="@+id/courseTitleText"
        app:layout_constraintBottom_toBottomOf="@+id/courseTitleText"
        android:layout_marginStart="12dp"
        android:contentDescription="Code icon" />

    <!-- Icono de perfil circular con efecto glow -->
    <androidx.cardview.widget.CardView
        android:id="@+id/profileIconContainer"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:cardBackgroundColor="#1A1A2E"
        app:cardCornerRadius="45dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/topBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBackground"
        android:background="@drawable/glow_border_login">

        <ImageView
            android:id="@+id/profileIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:src="@drawable/ic_person"
            app:tint="#8B5CF6"
            android:contentDescription="Profile icon" />
    </androidx.cardview.widget.CardView>

    <!-- Tarjeta de login con tema oscuro -->
    <androidx.cardview.widget.CardView
        android:id="@+id/loginCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="#1A1A2E"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profileIconContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Campo de usuario -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#16213E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_person"
                        app:tint="#8B5CF6"
                        android:contentDescription="User icon" />

                    <EditText
                        android:id="@+id/usernameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Ingrese su usuario"
                        android:textColorHint="#7C7C7C"
                        android:textColor="#FFFFFF"
                        android:inputType="text"
                        android:textSize="15sp"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Campo de contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Contraseña"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#16213E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lock"
                        app:tint="#8B5CF6"
                        android:contentDescription="Password icon" />

                    <EditText
                        android:id="@+id/passwordEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Ingrese su contraseña"
                        android:textColorHint="#7C7C7C"
                        android:textColor="#FFFFFF"
                        android:inputType="textPassword"
                        android:textSize="15sp"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />

                    <ImageView
                        android:id="@+id/togglePasswordVisibility"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_visibility"
                        app:tint="#7C7C7C"
                        android:contentDescription="Toggle password visibility" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Campo cédula: solo visible cuando dos usuarios comparten las mismas credenciales en distintas instituciones -->
            <TextView
                android:id="@+id/cedulaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Cédula"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cedulaHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu usuario existe en varias instituciones. Ingresa tu cédula para identificarte."
                android:textColor="#8B5CF6"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cedulaContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#16213E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_person"
                        app:tint="#8B5CF6"
                        android:contentDescription="Cédula icon" />

                    <EditText
                        android:id="@+id/cedulaEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="Ingrese su número de cédula"
                        android:textColorHint="#7C7C7C"
                        android:textColor="#FFFFFF"
                        android:inputType="number"
                        android:textSize="15sp"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón de ingresar con gradiente morado + spinner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_gradient_purple"
                    android:padding="14dp"
                    android:text="Ingresar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:elevation="4dp" />

                <ProgressBar
                    android:id="@+id/loginProgressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#FFFFFF"
                    android:visibility="gone"
                    android:elevation="8dp" />
            </FrameLayout>

            <!-- Separador "O" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#33FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="O"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#33FFFFFF" />
            </LinearLayout>

            <!-- Botón de Google -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/googleLoginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFFFFF"
                android:padding="12dp"
                android:text="Continuar con Google"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@null"
                app:strokeColor="#DDDDDD"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- Texto de olvidaste contraseña -->
            <TextView
                android:id="@+id/forgotPasswordTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="#8B5CF6"
                android:textSize="14sp"
                android:textStyle="italic" />

            <!-- Botón de registro -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#16213E"
                android:padding="12dp"
                android:text="¿No tienes una cuenta? Regístrate"
                android:textAllCaps="false"
                android:textColor="#8B5CF6"
                android:textSize="14sp"
                app:strokeColor="#8B5CF6"
                app:strokeWidth="2dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>