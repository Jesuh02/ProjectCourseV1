<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:animateLayoutChanges="true"
    tools:context=".ui.SelectTopicFragment">

    <!-- Subtle gradient overlay for depth -->
    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_header_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Navigation Bar with Blur Effect -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#1AFFFFFF"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Back Button with iOS style -->
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/bg_action_button_cupertino"
                android:backgroundTint="#15FFFFFF"
                android:padding="10dp"
                android:scaleType="centerInside"
                app:tint="#FFFFFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="Volver"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <!-- Title in Navigation Bar -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="Seleccionar Tema"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintStart_toEndOf="@id/backButton"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Course Title Card with Glassmorphism -->
    <androidx.cardview.widget.CardView
        android:id="@+id/courseTitleCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1FFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/topBarCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <!-- Decorative icon -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_courses_enhanced"
                android:background="@drawable/circle_purple_glow"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                app:tint="#FFFFFF" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tarea para"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Course Title -->
            <TextView
                android:id="@+id/selectTopicCourseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:maxLines="3"
                android:ellipsize="end"
                tools:text="Curso de Desarrollo de Aplicaciones Móviles" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section Header -->
    <TextView
        android:id="@+id/sectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:text="TEMAS DISPONIBLES"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/courseTitleCard" />

    <!-- RecyclerView with enhanced styling -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/topicsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:layoutAnimation="@anim/layout_fall_down"
        app:layout_constraintTop_toBottomOf="@id/sectionHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_topic_selection" />

    <!-- Empty State with Icon and Message -->
    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/topicsRecyclerView"
        app:layout_constraintBottom_toBottomOf="@id/topicsRecyclerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <!-- Empty state icon -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_document"
            android:background="@drawable/circle_bg_purple"
            android:backgroundTint="#15FFFFFF"
            android:padding="20dp"
            android:alpha="0.5"
            app:tint="#888888"
            android:layout_marginBottom="20dp" />

        <!-- Empty state message -->
        <TextView
            android:id="@+id/noTopicsSelectionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No hay temas disponibles"
            android:textColor="#999999"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <!-- Empty state subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Este curso aún no tiene temas creados"
            android:textColor="#666666"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:gravity="center" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>