<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.UserProfileViewFragment">    <!-- Botón de volver -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_arrow_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Volver" />

    <!-- Contenido con Sticky Headers -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000"
            android:theme="@style/ThemeOverlay.Material3.Dark"
            app:elevation="0dp"
            app:liftOnScroll="false"
            app:liftOnScrollColor="#000000">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:contentScrim="#000000"
                app:statusBarScrim="#000000"
                app:scrimAnimationDuration="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    app:layout_collapseMode="parallax">

                    <!-- Información del perfil del usuario -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/profile_card_background"
                        android:padding="24dp"
                        android:elevation="8dp">

                        <!-- Avatar del usuario -->
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/userAvatarImageView"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:src="@drawable/ic_profile"
                            app:civ_border_color="#A259FF"
                            app:civ_border_width="4dp"
                            android:layout_marginBottom="16dp" />

                        <!-- Nombre de usuario -->
                        <TextView
                            android:id="@+id/usernameTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Usuario"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif-medium" />

                        <!-- Estadísticas del usuario - tarjetas estilizadas -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp"
                            android:gravity="center">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardCornerRadius="12dp"
                                app:cardBackgroundColor="#242424"
                                android:layout_marginEnd="8dp"
                                android:elevation="6dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="14dp"
                                    android:gravity="center">

                                    <TextView
                                        android:id="@+id/coursesCountTextView"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="#A259FF"
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Cursos"
                                        android:textColor="#CCCCCC"
                                        android:textSize="12sp"
                                        android:layout_marginTop="6dp"
                                        android:fontFamily="sans-serif-medium" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardCornerRadius="12dp"
                                app:cardBackgroundColor="#242424"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:elevation="6dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="14dp"
                                    android:gravity="center">

                                    <TextView
                                        android:id="@+id/videosCountTextView"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="#A259FF"
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Videos"
                                        android:textColor="#CCCCCC"
                                        android:textSize="12sp"
                                        android:layout_marginTop="6dp"
                                        android:fontFamily="sans-serif-medium" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cardCornerRadius="12dp"
                                app:cardBackgroundColor="#242424"
                                android:layout_marginStart="8dp"
                                android:elevation="6dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="14dp"
                                    android:gravity="center">

                                    <TextView
                                        android:id="@+id/subscribersCountTextView"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="#A259FF"
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Seguidores"
                                        android:textColor="#CCCCCC"
                                        android:textSize="12sp"
                                        android:layout_marginTop="6dp"
                                        android:fontFamily="sans-serif-medium" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>

            <!-- Barra de búsqueda con fondo sólido oscuro (Sticky) - Sin BlurView para evitar whiteout -->
            <FrameLayout
                android:id="@+id/searchBarBlurView"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="6dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_glass_search_bar">

                <LinearLayout
                    android:id="@+id/searchBarLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/searchIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_search"
                        android:layout_marginStart="16dp"
                        app:tint="#FFFFFF" />

                    <EditText
                        android:id="@+id/searchEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Buscar en el contenido del usuario..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#99FFFFFF"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <ImageView
                        android:id="@+id/clearSearchButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_close"
                        android:layout_marginEnd="16dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:visibility="gone"
                        app:tint="#CCFFFFFF" />
                </LinearLayout>
            </FrameLayout>

            <!-- Botones de filtro con fondo sólido oscuro (Sticky) - Sin BlurView para evitar whiteout -->
            <FrameLayout
                android:id="@+id/filterBlurView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_glass_filter_container">

                <LinearLayout
                    android:id="@+id/filterContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <LinearLayout
                        android:id="@+id/coursesFilterButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_glass_filter_button_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="4dp">

                        <ImageView
                            android:id="@+id/coursesFilterIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_courses_icon"
                            android:tint="#1A1A1A"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/coursesFilterText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cursos"
                            android:textColor="#1A1A1A"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/coursesCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_badge_count"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:layout_marginStart="6dp"
                            android:minWidth="20dp"
                            android:gravity="center" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/videosFilterButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_glass_filter_button_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="4dp">

                        <ImageView
                            android:id="@+id/videosFilterIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_videos_icon"
                            android:tint="#FFFFFF"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/videosFilterText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Videos"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/videosCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_badge_count"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:layout_marginStart="6dp"
                            android:minWidth="20dp"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Contenedor para la lista y empty state -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- Skeleton Loading View -->
            <com.example.tareamov.ui.ShimmerFrameLayout
                android:id="@+id/skeletonContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:visibility="gone"
                tools:visibility="visible">

                <include layout="@layout/layout_profile_skeleton" />
            </com.example.tareamov.ui.ShimmerFrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contentRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="80dp"
                tools:listitem="@layout/item_created_course" />

            <TextView
                android:id="@+id/emptyStateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No hay contenido disponible"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone" />
        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Bottom Navigation reutilizable -->
    <include
          layout="@layout/component_bottom_navigation"
          android:id="@+id/bottomNavigation"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />
</androidx.constraintlayout.widget.ConstraintLayout>
