<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.VideoHomeFragment">

    <!-- Main Content - Video Background -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/videoViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Skeleton Loader Overlay -->
    <com.example.tareamov.ui.ShimmerFrameLayout
        android:id="@+id/skeletonContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        tools:visibility="visible">
        
        <include layout="@layout/layout_video_home_skeleton" />
    </com.example.tareamov.ui.ShimmerFrameLayout>

    <!-- Top Navigation Container - Professional Minimal Design -->
    <FrameLayout
        android:id="@+id/topNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="26dp"
        android:paddingBottom="8dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Navigation Tabs - Clean Professional Layout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topNavTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="visible">

            <!-- Right Side Icons Container -->
            <LinearLayout
                android:id="@+id/rightIconsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent" 
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Hidden tabs for compatibility -->
                <TextView
                    android:id="@+id/enVivoTab"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/clipsTab"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Evaluative Reinforcement Icon -->
                <ImageView
                    android:id="@+id/evaluativeReinforcementIconImageView"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_evaluative_reinforcement"
                    android:contentDescription="Refuerzo Evaluativo"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:visibility="gone" />

                <!-- AI Assistant Button (Grading) -->
                <ImageView
                    android:id="@+id/aiAssistantIconImageView"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_task_grading"
                    android:contentDescription="Asistente de Calificación"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:visibility="gone" />

                <!-- Database Orbit Button -->
                <ImageView
                    android:id="@+id/databaseIconImageView"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_database_orbit_animated_avd"
                    android:contentDescription="Database"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:padding="4dp"
                    android:visibility="gone" />

                <!-- Profile Avatar -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profileAvatars"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_profile_avatars"
                    app:civ_border_color="#FFFFFF"
                    app:civ_border_width="1.5dp" />

                <!-- More Options Button (3 dots) -->
                <ImageButton
                    android:id="@+id/moreOptionsButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Más opciones"
                    android:src="@drawable/ic_more_vert"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:visibility="visible"
                    app:tint="#FFFFFF" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/component_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>