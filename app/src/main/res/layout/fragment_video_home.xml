<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.VideoHomeFragment">

    <!-- Main Content - Video Background -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/videoViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Skeleton Loader Overlay -->
    <FrameLayout
        android:id="@+id/skeletonContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:stateListAnimator="@animator/skeleton_shimmer"
        tools:visibility="visible">
        
        <include layout="@layout/layout_video_home_skeleton" />
    </FrameLayout>

    <!-- Top Navigation Container - Professional Minimal Design -->
    <FrameLayout
        android:id="@+id/topNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Navigation Tabs - Clean Professional Layout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topNavTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="visible">

            <!-- Search Button (Left) -->
            <ImageButton
                android:id="@+id/toggleSearchButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Buscar videos"
                android:src="@android:drawable/ic_menu_search"
                android:scaleType="centerInside"
                android:padding="8dp"
                app:tint="#FFFFFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Center Pill Buttons Container -->
            <LinearLayout
                android:id="@+id/centerPillContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_container"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Live/En Vivo Tab with Glow -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    
                    <ImageView
                        android:id="@+id/enVivoGlow"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/bg_glow_orange"
                        android:alpha="0.6" />
                    
                    <ImageView
                        android:id="@+id/enVivoButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_live_stream"
                        android:scaleType="centerInside"
                        android:padding="6dp"
                        android:background="@drawable/bg_pill_button_active"
                        android:contentDescription="En Vivo" />
                </FrameLayout>

                <!-- Courses Tab with Glow -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">
                    
                    <ImageView
                        android:id="@+id/coursesGlow"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/bg_glow_purple"
                        android:alpha="0.6" />
                    
                    <ImageView
                        android:id="@+id/coursesButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_login_minimal"
                        android:scaleType="centerInside"
                        android:padding="6dp"
                        android:background="@drawable/bg_pill_button_inactive"
                        android:contentDescription="Cursos" />
                </FrameLayout>
            </LinearLayout>

            <!-- Right Side Icons Container -->
            <LinearLayout
                android:id="@+id/rightIconsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Hidden tabs for compatibility -->
                <TextView
                    android:id="@+id/enVivoTab"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/clipsTab"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Database Orbit Button -->
                <ImageView
                    android:id="@+id/databaseOrbitButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_database_orbit_animated_avd"
                    android:contentDescription="Database"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:padding="4dp" />

                <!-- Profile Avatar -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profileAvatars"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_profile_avatars"
                    app:civ_border_color="#FFFFFF"
                    app:civ_border_width="1.5dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Search Bar (ocupa todo el espacio cuando está visible) -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/searchBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:elevation="8dp"
            android:visibility="gone"
            app:blurOverlayColor="#4D000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_filter_item">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/searchEditText"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Buscar videos..."
                        android:textColorHint="#CCFFFFFF"
                        android:textColor="#FFFFFF"
                        android:drawableStart="@android:drawable/ic_menu_search"
                        android:drawableTint="#FFFFFF"
                        android:drawablePadding="12dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true" />

                    <ImageButton
                        android:id="@+id/closeSearchButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Cancelar"
                        app:tint="#FFFFFF" />
                </LinearLayout>

                <!-- Search Filter Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/searchFilterChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/filterAllChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Todos"
                            android:checked="true"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/filterTitleChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Título"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/filterUsernameChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Usuario"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/filterCategoryChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Categoría"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>
    </FrameLayout>

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/component_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>