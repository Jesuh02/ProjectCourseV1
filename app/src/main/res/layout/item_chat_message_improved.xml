<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0A0A0A">

    <!-- User Message Container -->
    <LinearLayout
        android:id="@+id/userMessageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#0A0A0A"
        android:gravity="end|top"
        android:visibility="gone">

        <!-- User Message Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <!-- User header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Message Bubble -->
            <LinearLayout
                android:id="@+id/messageBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_message_user_cursor"
                android:maxWidth="320dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:elevation="1dp">

                <!-- Attached File Container -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/attachedFileContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#333333"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <!-- Icon container -->
                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_excel_icon"
                            android:padding="6dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_table_chart"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <!-- Text info -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/attachedFileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="data_septiembre.xlsx"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:maxWidth="180dp" />

                            <TextView
                                android:id="@+id/attachedFileType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hoja de cálculo"
                                android:textColor="#AAAAAA"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/userMessageTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E8E8E8"
                    android:textSize="15sp"
                    android:textIsSelectable="true"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif"
                    android:text="Mensaje del usuario" />
            </LinearLayout>

            <!-- Action buttons container -->
            <LinearLayout
                android:id="@+id/userActionButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="4dp"
                android:gravity="end|center_vertical">

                <ImageButton
                    android:id="@+id/editButtonUser"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_edit_minimal"
                    android:tint="#555555"
                    android:contentDescription="Editar mensaje"
                    android:padding="4dp" />

                <ImageButton
                    android:id="@+id/copyButtonUser"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_copy_minimal"
                    android:tint="#555555"
                    android:contentDescription="Copiar mensaje"
                    android:padding="4dp" />

                <ImageButton
                    android:id="@+id/shareButtonUser"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_share_minimal"
                    android:tint="#555555"
                    android:contentDescription="Compartir mensaje"
                    android:padding="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/userMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4A4A4A"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:text="00:00" />
        </LinearLayout>

        <!-- User Avatar -->
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#2A2A2A">

            <ImageView
                android:id="@+id/userAvatar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                app:tint="#E0E0E0" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bot Message Container -->
    <LinearLayout
        android:id="@+id/botMessageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#0A0A0A"
        android:gravity="start|top"
        android:visibility="gone">

        <!-- Bot Avatar -->
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#10A37F">

            <ImageView
                android:id="@+id/botAvatar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cpu"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Bot Message Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:maxWidth="320dp">

            <!-- Bot header with model info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/modelNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DeepSeek-V3.2-Speciale"
                    android:textColor="#10A37F"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="#4CAF50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAG"
                    android:textColor="#4CAF50"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Message content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_message_bot_cursor"
                android:padding="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/botMessageTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E8E8E8"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:textIsSelectable="true"
                    android:fontFamily="sans-serif"
                    android:text="Respuesta del modelo" />
            </LinearLayout>

            <!-- Action buttons container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="start|center_vertical">

                <ImageButton
                    android:id="@+id/copyButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_copy_minimal"
                    android:tint="#555555"
                    android:contentDescription="Copiar mensaje"
                    android:padding="4dp" />

                <ImageButton
                    android:id="@+id/speakButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_volume_up_minimal"
                    android:tint="#555555"
                    android:contentDescription="Escuchar mensaje"
                    android:padding="4dp" />



                <ImageButton
                    android:id="@+id/shareButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_share_minimal"
                    android:tint="#555555"
                    android:contentDescription="Compartir mensaje"
                    android:padding="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/botMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4A4A4A"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:text="00:00" />
        </LinearLayout>
    </LinearLayout>

    <!-- Enhanced Calification buttons container with small aesthetic design -->
    <LinearLayout
        android:id="@+id/calificationButtonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#0A0A0A"
        android:visibility="gone">

        <!-- Header text for buttons -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Agregar calificación al sistema?"
            android:textColor="#666666"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <!-- Small aesthetic buttons row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center">

            <!-- Small Accept button -->
            <Button
                android:id="@+id/addCalificationButton"
                android:layout_width="72dp"
                android:layout_height="42dp"
                android:backgroundTint="#4CAF50"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:contentDescription="Agregar calificación"
                android:layout_marginEnd="8dp"
                android:elevation="0dp"
                style="@style/Widget.Material3.Button.UnelevatedButton" />

            <!-- Small Reject button -->
            <Button
                android:id="@+id/rejectCalificationButton"
                android:layout_width="72dp"
                android:layout_height="42dp"
                android:backgroundTint="#f44336"
                android:text="✗"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:contentDescription="No agregar calificación"
                android:layout_marginStart="8dp"
                android:elevation="0dp"
                style="@style/Widget.Material3.Button.UnelevatedButton" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden views for compatibility -->
    <TextView
        android:id="@+id/messageTimestampTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
