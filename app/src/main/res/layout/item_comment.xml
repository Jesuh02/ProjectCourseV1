<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- User Avatar -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/commentAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_profile"
        app:civ_border_width="0dp"
        android:layout_gravity="top" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <!-- Username and Timestamp in same line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/commentUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="usuario"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/commentTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="5 d"
                android:textColor="#888888"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Comment Text -->
        <TextView
            android:id="@+id/commentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Comentario de ejemplo"
            android:textColor="#EEEEEE"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.15" />

        <!-- Reply Button -->
        <TextView
            android:id="@+id/replyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Responder"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:paddingTop="2dp"/>

        <!-- Replies Section (Collapsed/Expanded) -->
        <LinearLayout
            android:id="@+id/repliesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <!-- "View replies" toggle -->
            <LinearLayout
                android:id="@+id/viewRepliesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="?attr/selectableItemBackground">

                <View
                    android:layout_width="24dp"
                    android:layout_height="1dp"
                    android:background="#666666"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/viewRepliesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver 4 respuestas más"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Container for actual reply items -->
            <LinearLayout
                android:id="@+id/repliesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="8dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Like Section - Right aligned -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="12dp"
        android:layout_gravity="top"
        android:paddingTop="4dp">

        <ImageView
            android:id="@+id/commentLikeIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_heart_outline"
            app:tint="#888888" />

        <TextView
            android:id="@+id/commentLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
