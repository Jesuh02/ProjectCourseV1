<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/contentIconView"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_menu_help"
        android:tint="#8B5CF6"
        android:contentDescription="Icono de contenido" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/contentNameView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del archivo"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/contentTypeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:textColor="#C9C1FF"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/deleteContentButton"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_delete_button"
        android:src="@drawable/ic_delete"
        android:contentDescription="Eliminar contenido"
        android:tint="#FFFFFF"
        android:padding="6dp"
        android:layout_marginEnd="4dp"
        android:alpha="0.85"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/ic_menu_view"
        android:tint="#FFFFFF"
        android:alpha="0.5"
        android:contentDescription="Ver archivo" />
</LinearLayout>