<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_stat_icon_circle"
        android:padding="8dp">

        <ImageView
            android:id="@+id/contentIconView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_attach_file"
            android:tint="#FFFFFF"
            android:scaleType="fitCenter"
            android:contentDescription="Icono de contenido" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/contentNameView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del archivo"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/contentTypeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:textColor="#9B7EFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.06"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/deleteContentButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_delete_button"
        android:src="@drawable/ic_delete"
        android:contentDescription="Eliminar contenido"
        android:tint="#FFFFFF"
        android:padding="6dp"
        android:layout_marginEnd="6dp"
        android:alpha="0.85"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_arrow_forward"
        android:tint="#FFFFFF"
        android:alpha="0.4"
        android:contentDescription="Abrir archivo" />
</LinearLayout>
