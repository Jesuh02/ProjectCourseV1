<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Video thumbnail (shown for video content) -->
    <FrameLayout
        android:id="@+id/contentThumbnailFrame"
        android:layout_width="72dp"
        android:layout_height="52dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_video_thumb_frame"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/contentThumbnailView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Miniatura del video"
            android:scaleType="centerCrop" />

        <!-- Play overlay on thumbnail -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_play_circle"
            android:tint="#CCFFFFFF"
            android:alpha="0.85" />

    </FrameLayout>

    <!-- File type icon (shown for non-video) -->
    <FrameLayout
        android:id="@+id/contentIconFrame"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_stat_icon_circle"
        android:padding="8dp">

        <ImageView
            android:id="@+id/contentIconView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Icono de contenido"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_attach_file"
            android:tint="#9B7EFF" />
    </FrameLayout>

    <!-- Title + type/duration row -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/contentNameView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Nombre del archivo"
            android:textColor="#E8EAF6"
            android:textSize="13sp" />

        <!-- Type + Duration row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/contentTypeView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_regular"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="Tipo"
                android:textColor="#9B7EFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/contentDurationView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/sf_pro_display_regular"
                android:includeFontPadding="false"
                android:textColor="#6B6F88"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="· 42m"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

    <!-- Status chip (Completada / etc.) -->
    <TextView
        android:id="@+id/contentStatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_status_completed"
        android:fontFamily="@font/sf_pro_display_semibold"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#10B981"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="Completada"
        tools:visibility="visible" />

    <!-- Delete button (creator only) -->
    <ImageButton
        android:id="@+id/deleteContentButton"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Eliminar contenido"
        android:padding="5dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_delete"
        android:tint="#EF4444"
        android:alpha="0.7"
        android:visibility="gone" />

    <!-- Arrow indicator (shown when no delete button) -->
    <ImageView
        android:id="@+id/contentArrowView"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="Abrir"
        android:src="@drawable/ic_arrow_forward"
        android:tint="#8B8FA8"
        android:alpha="0.5" />

</LinearLayout>
