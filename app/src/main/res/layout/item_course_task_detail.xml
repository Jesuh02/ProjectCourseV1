<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    android:layout_marginLeft="0dp"
    android:layout_marginRight="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="false"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp"
        android:background="@drawable/bg_card_premium"
        android:animateLayoutChanges="true">

        <!-- Header row: indicator + content + action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:id="@+id/taskIndicator"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#4CAF50" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/taskNameTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre de la Tarea"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/taskDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción de la tarea"
                    android:textColor="#C2B8FF"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:id="@+id/gradeStatusTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calificación: 0/10"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/editTaskButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/ic_menu_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#D0B2FF"
                android:padding="12dp"
                android:contentDescription="Edit Task" />
        </LinearLayout>

        <!-- Attachments container -->
        <LinearLayout
            android:id="@+id/taskContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:layoutAnimation="@anim/layout_fall_down_fast">

            <TextView
                android:id="@+id/taskContentLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Archivos adjuntos:"
                android:textColor="#C2B8FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/uploadSubmissionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subir Tarea"
            android:layout_gravity="end"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_premium"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</androidx.cardview.widget.CardView>