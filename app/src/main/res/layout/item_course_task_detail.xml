<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_dark_card"
    android:orientation="vertical"
    android:elevation="4dp">

    <!-- ─── HEADER ROW ─── -->
    <LinearLayout
        android:id="@+id/taskHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">

        <!-- Status icon circle -->
        <FrameLayout
            android:id="@+id/taskStatusIconFrame"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_stat_icon_circle"
            android:padding="8dp">

            <ImageView
                android:id="@+id/taskStatusIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Estado de tarea"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_assignment_turned_in"
                android:tint="#8B8FA8" />
        </FrameLayout>

        <!-- Title + description -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/taskNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.01"
                android:lineSpacingMultiplier="1.15"
                android:textColor="#E8EAF6"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Cuestionario: Fundamentos de IA" />

            <TextView
                android:id="@+id/taskDescriptionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display_regular"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.35"
                android:maxLines="2"
                android:textColor="#8B8FA8"
                android:textSize="13sp"
                tools:text="Responde las preguntas sobre los conceptos básicos de inteligencia artificial." />

        </LinearLayout>

        <!-- Edit + Delete (creator only) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/editTaskButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Editar tarea"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_edit"
                android:tint="#9B8FA8"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/deleteTaskButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar tarea"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete"
                android:tint="#EF4444"
                android:alpha="0.8"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <!-- ─── BADGE + DATE ROW ─── -->
    <LinearLayout
        android:id="@+id/taskBadgeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- Status badge chip -->
        <TextView
            android:id="@+id/taskBadgeChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pending"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="Pendiente"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            tools:text="Completada" />

        <!-- Due date chip -->
        <TextView
            android:id="@+id/taskDueChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tag_outlined_pill"
            android:fontFamily="@font/sf_pro_display_regular"
            android:includeFontPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#8B8FA8"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="15 Feb 2026"
            tools:visibility="visible" />

        <!-- Grade (shown when graded) -->
        <TextView
            android:id="@+id/gradeStatusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:includeFontPadding="false"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="9/10"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- ─── PROGRESS BAR (in-progress tasks only) ─── -->
    <ProgressBar
        android:id="@+id/taskProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:indeterminateOnly="false"
        android:max="100"
        android:progress="60"
        android:progressDrawable="@drawable/bg_task_progress_bar"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- ─── SEPARATOR ─── -->
    <View
        android:id="@+id/contentSeparator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="#12FFFFFF"
        android:visibility="gone" />

    <!-- ─── CONTENT LABEL (hidden, compat) ─── -->
    <TextView
        android:id="@+id/taskContentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- ─── CONTENT CONTAINER ─── -->
    <LinearLayout
        android:id="@+id/taskContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp" />

    <!-- ─── SUBMIT BUTTON (students) ─── -->
    <Button
        android:id="@+id/uploadSubmissionButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_entregar_button"
        android:drawableStart="@drawable/ic_upload_outline"
        android:drawablePadding="10dp"
        android:drawableTint="#00D4FF"
        android:fontFamily="@font/sf_pro_display_semibold"
        android:gravity="center"
        android:stateListAnimator="@null"
        android:text="Entregar tarea"
        android:textAllCaps="false"
        android:textColor="#00D4FF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- ─── SUBMIT TASK BUTTON (creator, compat) ─── -->
    <Button
        android:id="@+id/submitTaskButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_entregar_button"
        android:drawableStart="@drawable/ic_upload_outline"
        android:drawablePadding="8dp"
        android:drawableTint="#00D4FF"
        android:fontFamily="@font/sf_pro_display_semibold"
        android:text="Subir entrega"
        android:textAllCaps="false"
        android:textColor="#00D4FF"
        android:visibility="gone" />

</LinearLayout>
