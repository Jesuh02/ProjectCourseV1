<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121212"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp"
    android:stateListAnimator="@animator/skeleton_shimmer">

    <!-- Skeleton Unread Indicator -->
    <View
        android:id="@+id/skeletonUnreadIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_skeleton_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/skeletonSenderAvatar"
        app:layout_constraintBottom_toBottomOf="@id/skeletonSenderAvatar" />

    <!-- Skeleton Sender Avatar -->
    <View
        android:id="@+id/skeletonSenderAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_skeleton_circle"
        app:layout_constraintStart_toEndOf="@id/skeletonUnreadIndicator"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Skeleton Content Container -->
    <LinearLayout
        android:id="@+id/skeletonContentContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/skeletonSenderAvatar"
        app:layout_constraintEnd_toStartOf="@id/skeletonThumbnail"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Skeleton Title -->
        <View
            android:layout_width="120dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_skeleton_rect" />

        <!-- Skeleton Message Line 1 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton_rect" />

        <!-- Skeleton Message Line 2 -->
        <View
            android:layout_width="180dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_skeleton_rect" />

        <!-- Skeleton Time -->
        <View
            android:layout_width="80dp"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton_rect" />
    </LinearLayout>

    <!-- Skeleton Thumbnail -->
    <View
        android:id="@+id/skeletonThumbnail"
        android:layout_width="80dp"
        android:layout_height="45dp"
        android:background="@drawable/bg_skeleton_rect"
        app:layout_constraintEnd_toStartOf="@id/skeletonMenuButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Skeleton Menu Button -->
    <View
        android:id="@+id/skeletonMenuButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_skeleton_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

