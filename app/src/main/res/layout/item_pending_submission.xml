<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_purple_glass"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    android:foreground="?attr/selectableItemBackground">

    <!-- Main horizontal: Avatar | Content + Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- ═══ Avatar with border ring ═══ -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/studentAvatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:src="@drawable/default_avatar"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/circle_shape" />

            <!-- Green ring border overlay -->
            <View
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/avatar_border_ring" />
        </FrameLayout>

        <!-- ═══ Content Column ═══ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Row 1: Task title + Points badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/taskTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Tarea"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Proyecto Final: Red ..." />

                <TextView
                    android:id="@+id/submissionPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30 pts"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_background"
                    android:backgroundTint="#6C63FF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <!-- Row 2: Course name -->
            <TextView
                android:id="@+id/courseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Curso"
                android:textColor="#B8B3FF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Deep Learning Avanzado" />

            <!-- Row 3: Student + Time | Actions + Priority -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- Student name with icon -->
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_person"
                    app:tint="#9B9BB3"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/studentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estudiante"
                    android:textColor="#CCCAFF"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="90dp"
                    tools:text="Juan Pérez" />

                <!-- Time with icon -->
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_clock"
                    app:tint="#9B9BB3"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/submissionDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="hace 2h"
                    android:textColor="#9B9BB3"
                    android:textSize="11sp"
                    android:maxLines="1" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Action buttons row -->
                <ImageView
                    android:id="@+id/btnApprove"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="#4ADE80"
                    android:padding="2dp"
                    android:background="@drawable/ripple_circle"
                    android:contentDescription="Calificar" />

                <ImageView
                    android:id="@+id/btnReject"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_visibility"
                    app:tint="#64D2FF"
                    android:padding="2dp"
                    android:background="@drawable/ripple_circle"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Ver detalle" />

                <!-- Priority badge -->
                <TextView
                    android:id="@+id/priorityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="alta"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.04"
                    android:background="@drawable/badge_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:minWidth="38dp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
