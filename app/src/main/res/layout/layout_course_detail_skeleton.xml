<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient"
    android:paddingTop="80dp">

    <!-- Hero Section Skeleton -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_skeleton_shape"
        android:padding="24dp"
        android:stateListAnimator="@animator/skeleton_shimmer">

        <!-- Icon + label row -->
        <View
            android:id="@+id/iconSkeleton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_skeleton_circle"
            android:stateListAnimator="@animator/skeleton_shimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="90dp"
            android:layout_height="14dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_skeleton_shape"
            android:stateListAnimator="@animator/skeleton_shimmer"
            app:layout_constraintStart_toEndOf="@id/iconSkeleton"
            app:layout_constraintTop_toTopOf="@id/iconSkeleton"
            app:layout_constraintBottom_toBottomOf="@id/iconSkeleton" />

        <!-- Divider -->
        <View
            android:id="@+id/dividerSkeleton"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#22FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/iconSkeleton" />

        <!-- Title -->
        <View
            android:id="@+id/titleSkeleton"
            android:layout_width="220dp"
            android:layout_height="28dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_skeleton_shape"
            android:stateListAnimator="@animator/skeleton_shimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerSkeleton" />

        <!-- Title line 2 -->
        <View
            android:id="@+id/titleSkeleton2"
            android:layout_width="160dp"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_skeleton_shape"
            android:stateListAnimator="@animator/skeleton_shimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleSkeleton" />

        <!-- Description line 1 -->
        <View
            android:id="@+id/descLine1"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_skeleton_shape"
            android:stateListAnimator="@animator/skeleton_shimmer"
            app:layout_constraintTop_toBottomOf="@id/titleSkeleton2" />

        <!-- Description line 2 -->
        <View
            android:id="@+id/descLine2"
            android:layout_width="200dp"
            android:layout_height="13dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_skeleton_shape"
            android:stateListAnimator="@animator/skeleton_shimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/descLine1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tabs Skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_skeleton_shape"
        android:orientation="horizontal"
        android:padding="4dp"
        android:stateListAnimator="@animator/skeleton_shimmer">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_skeleton_shape"
            android:alpha="0.6"
            android:stateListAnimator="@animator/skeleton_shimmer" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_skeleton_shape"
            android:alpha="0.3"
            android:stateListAnimator="@animator/skeleton_shimmer" />
    </LinearLayout>

    <!-- Content List Skeletons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Topic card 1 -->
        <View
            android:layout_width="130dp"
            android:layout_height="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_skeleton_shape"
            android:stateListAnimator="@animator/skeleton_shimmer" />

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_skeleton_shape"
            android:stateListAnimator="@animator/skeleton_shimmer" />

        <!-- Topic card 2 -->
        <View
            android:layout_width="160dp"
            android:layout_height="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_skeleton_shape"
            android:stateListAnimator="@animator/skeleton_shimmer" />

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_skeleton_shape"
            android:stateListAnimator="@animator/skeleton_shimmer" />

        <!-- Topic card 3 (partial) -->
        <View
            android:layout_width="110dp"
            android:layout_height="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_skeleton_shape"
            android:alpha="0.5"
            android:stateListAnimator="@animator/skeleton_shimmer" />

        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_skeleton_shape"
            android:alpha="0.5"
            android:stateListAnimator="@animator/skeleton_shimmer" />

    </LinearLayout>

</LinearLayout>
