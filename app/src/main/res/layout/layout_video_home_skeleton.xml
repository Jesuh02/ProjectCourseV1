<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Nav Placeholder -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">
        
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_skeleton_circle" />
            
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        
        <View
            android:layout_width="100dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_skeleton_shape" />
            
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_skeleton_circle" />
    </LinearLayout>

    <!-- Right Actions Placeholder -->
    <LinearLayout
        android:id="@+id/rightActionsSkeleton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_skeleton_circle" />

        <View
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_skeleton_circle" />
        <View
            android:layout_width="20dp"
            android:layout_height="8dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_skeleton_shape" />

        <View
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_skeleton_circle" />
        <View
            android:layout_width="20dp"
            android:layout_height="8dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_skeleton_shape" />

        <View
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_skeleton_circle" />
        <View
            android:layout_width="20dp"
            android:layout_height="8dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_skeleton_shape" />
            
        <View
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_skeleton_circle" />
    </LinearLayout>

    <!-- Bottom Info Placeholder -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="120dp"
            android:layout_height="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_skeleton_shape" />

        <View
            android:layout_width="240dp"
            android:layout_height="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_skeleton_shape" />
            
        <View
            android:layout_width="180dp"
            android:layout_height="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_skeleton_shape" />
            
        <View
            android:layout_width="140dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_skeleton_shape" />
    </LinearLayout>

    <!-- Bottom Nav Placeholder -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <View android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_margin="12dp" android:background="@drawable/bg_skeleton_shape" />
        <View android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_margin="12dp" android:background="@drawable/bg_skeleton_shape" />
        <View android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_margin="8dp" android:background="@drawable/bg_skeleton_shape" />
        <View android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_margin="12dp" android:background="@drawable/bg_skeleton_shape" />
        <View android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:layout_margin="12dp" android:background="@drawable/bg_skeleton_shape" />
        
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
