        <action
            android:id="@+id/action_notificacionesFragment_to_exploreFragment"
            app:destination="@id/exploreFragment" />
        <action
            android:id="@+id/action_notificacionesFragment_to_contentUploadFragment"
            app:destination="@id/contentUploadFragment" />
        <action
            android:id="@+id/action_notificacionesFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_notificacionesFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_notificacionesFragment_to_courseDetailFragment"
            app:destination="@id/courseDetailFragment" />
        <action
            android:id="@+id/action_notificacionesFragment_to_subjectsListFragment"
            app:destination="@id/subjectsListFragment" />
        <action
            android:id="@+id/action_notificacionesFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment" />
    </fragment>

    <!-- Single registerFragment definition -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.tareamov.ui.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <!-- Arguments for Google Sign-In data -->
        <argument
            android:name="googleEmail"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="googleNombres"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="googleApellidos"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="googleAvatar"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="isGoogleSignIn"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
