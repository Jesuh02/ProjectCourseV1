        android:name="com.example.tareamov.ui.CourseCreationFragment"
        android:label="Course Creation"
        tools:layout="@layout/fragment_course_creation">
        <argument
            android:name="courseId"
            app:argType="long"
            android:defaultValue="-1L" />
        <argument
